{
  "uid": "llm-gateway-errors",
  "title": "Errors",
  "description": "LLM request failures: overall error rate, and breakdowns by provider and error type.",
  "tags": ["llm-gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Error Rate Over Time",
      "description": "LLM request errors per second, all providers/models combined.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "errors/sec" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(llm_errors_total[5m]))",
          "legendFormat": "errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors by Provider",
      "description": "Error rate grouped by which provider the failing candidate was.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(llm_errors_total[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors by Type",
      "description": "Error rate grouped by exception type (timeout, rate limit, auth, malformed response, ...).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(llm_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Errors by Model + Provider (table)",
      "description": "Total errors in the selected range, broken down by model, provider, and error type.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (model, provider, error_type) (increase(llm_errors_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx Rate",
      "description": "Server-error HTTP responses per second, by route — surfaces failures that never made it to an LLM call (auth, validation, routing config, etc.).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (path) (rate(http_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    }
  ]
}
